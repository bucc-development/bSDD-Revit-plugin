<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared icon/resource helper. Multi-targeted so both the net48 (2024) and
       net8 (2025/2026) Revit version projects can reference it. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>BsddRevitPlugin.Resources</RootNamespace>
    <AssemblyName>BsddRevitPlugin.Resources</AssemblyName>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Icons are embedded (looked up by manifest resource name) and also copied next to the
       add-in so the installer can pick them up. The SDK default logical name
       "BsddRevitPlugin.Resources.Images.Icons.<file>" matches ResourceImage.GetIcon(). -->
  <ItemGroup>
    <EmbeddedResource Include="Images\Icons\BsddLabel.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\Icons\IfcExport.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
