<Project Sdk="Microsoft.NET.Sdk">

  <!-- Revit 2024 host project (.NET Framework 4.8). Thin: delegates to the shared
       Common + Logic libraries. Consumes the net48 target of the multi-targeted libs. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>BsddRevitPlugin.V2024</RootNamespace>
    <!-- Output assembly is "BsddRevitPlugin.dll" (referenced by the .addin). -->
    <AssemblyName>BsddRevitPlugin</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="NLog" Version="5.1.0" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Revit_All_Main_Versions_IFC_x64" Version="2024.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- CefSharp referenced for COMPILE ONLY (IncludeAssets=compile): Revit ships and loads its own
       CefSharp at runtime, so we neither deploy nor flow these binaries. The .NET Framework build
       uses the CefSharp.Wpf package. Bump the version to match the CefSharp that Revit 2024 ships
       if you hit a runtime mismatch (check C:\Program Files\Autodesk\Revit 2024\CefSharp). -->
  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf" Version="105.3.390" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BsddRevitPlugin.Logic\BsddRevitPlugin.Logic.csproj" />
    <ProjectReference Include="..\BsddRevitPlugin.Resources\BsddRevitPlugin.Resources.csproj" />
  </ItemGroup>

  <!-- Shared command/startup code compiled into this host assembly. -->
  <Import Project="..\BsddRevitPlugin.Common\BsddRevitPlugin.Common.projitems" Label="Shared" />

  <ItemGroup>
    <None Update="BsddRevitPlugin.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Convenience deploy on Debug builds. -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\2024</RevitAddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFiles="@(DeployFiles->'$(RevitAddinsDir)\BsddRevitPlugin\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="BsddRevitPlugin.addin" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>



