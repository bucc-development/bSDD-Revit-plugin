<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Multi-targeted shared logic library.
      net48           -> Revit 2024 (.NET Framework 4.8)
      net8.0-windows  -> Revit 2025 / 2026 (.NET 8)
    The matching Revit version project (BsddRevitPlugin.2024 / .2025 / .2026) references this
    project and automatically consumes the right target framework.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>BsddRevitPlugin.Logic</RootNamespace>
    <AssemblyName>BsddRevitPlugin.Logic</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Keep the existing hand-written Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Revit add-ins must not ship their own copy of the shared NuGet libs that Revit already loads;
         copy only what Revit does not provide. Newtonsoft/NLog handled per-package below. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Per-target compile constant so version-sensitive code can branch (e.g. REVIT2024 vs REVIT2026). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <DefineConstants>$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Shared third-party packages (these DO get copied next to the add-in). -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="NLog" Version="5.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- Revit API + IFC exporter, per target framework. compile-time only (Revit provides them at runtime). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Revit_All_Main_Versions_IFC_x64" Version="2024.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2025.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Revit_All_Main_Versions_IFC_x64" Version="2025.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- .NET Framework assemblies that are not implicitly referenced by the SDK for net48.
       (On net8 these are all part of the shared framework.) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Reflection.Context" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Content copied next to the add-in (parameter mapping + settings templates). -->
  <ItemGroup>
    <None Update="Resources\IFC Shared Parameters - bSDD Revit Plugin.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources\UDPS-Quantities.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources\UDPS-Quantities-4x3.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="UI\Settings\BsddSettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
